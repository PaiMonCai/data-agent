# Docker Compose deployment settings
# 默认使用 GHCR latest；生产环境建议固定版本，例如 ghcr.io/paimoncai/data-agent:1.0.0
DATA_AGENT_IMAGE=ghcr.io/paimoncai/data-agent:latest
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_PORT=3000

# 首次部署：仅当数据库中不存在管理员时使用。创建成功后可从 .env 删除。
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# 用于加密后台保存的 SMTP 密码；建议独立随机值（未设置时暂时回退 SESSION_SECRET）。
SYSTEM_CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret

# 正式 HTTPS 部署改为 true
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# 生产环境经过反向代理时，建议明确写公开 Origin，例如：
# APP_ORIGIN=https://data.example.com
APP_ORIGIN=

# OpenAI-compatible LLM gateway
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODELS=
LLM_REQUESTS_PER_MINUTE=10
LLM_REQUESTS_PER_DAY=300
LLM_MAX_INPUT_CHARS=200000
LLM_TIMEOUT_MS=180000

# OTP mail: console only for development/testing
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Data Agent <no-reply@example.com>
