# Docker Compose deployment settings
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_PORT=3000

# 正式 HTTPS 部署改为 true
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# 生产环境经过反向代理时，建议明确写公开 Origin，例如：
# APP_ORIGIN=https://data.example.com
APP_ORIGIN=

# OpenAI-compatible LLM gateway
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODELS=

# OTP mail: console only for development/testing
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Data Agent <no-reply@example.com>
