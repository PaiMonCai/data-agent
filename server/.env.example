NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://data_agent:change-me@127.0.0.1:5432/data_agent

# 至少 32 字符；生产环境请使用随机高强度值
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_DAYS=30
SESSION_COOKIE_NAME=data_agent_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# 前后端分域时填写，例如 https://data.example.com
# 同域部署留空即可
APP_ORIGIN=

# 静态前端；Docker 镜像会把 index.html/assets 放进 ./public
SERVE_STATIC=true
STATIC_ROOT=./public

# OpenAI-compatible 网关，例如 OpenAI / NewAPI / 自建中转
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# 可选：逗号分隔。设置后 /models 直接使用这里的模型目录，不请求上游 /models
LLM_MODELS=

# OTP
OTP_TTL_MINUTES=10
OTP_MIN_INTERVAL_SECONDS=60
OTP_HOURLY_LIMIT=5

# console 仅测试使用；生产改成 smtp
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Data Agent <no-reply@example.com>
